APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Demo-request mail. Locally MAIL_MAILER=log writes the email to the log
# instead of sending; production uses smtp with the mailbox credentials.
MAIL_MAILER=log
MAIL_SCHEME=smtps
MAIL_HOST=mail.corexweb.co.za
MAIL_PORT=465
MAIL_USERNAME=info@corexweb.co.za
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="info@corexweb.co.za"
MAIL_FROM_NAME="CoreX OS"

# Where "Book a demo" enquiries, pricing enquiries and contact-page messages are delivered.
MAIL_DEMO_TO=info@corexweb.co.za
MAIL_DEMO_TO_NAME="CoreX OS"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ── CoreX OS webinars ────────────────────────────────────────────────
# CoreX owns the webinars, the registrants and the demo credentials each
# registrant is issued. This site stores none of it; these tokens are how it
# asks. They are SERVER-SIDE ONLY — never expose them to a browser, and never
# commit real values.
#
# Prove a token before trusting it:
#   php artisan corex:ping
COREX_API_BASE=https://corexos.co.za

# Public registration page only. Cannot read the registrant list.
COREX_WEBINAR_PUBLIC_TOKEN=

# Admin console only: webinar admin + registrant PII.
COREX_WEBINAR_ADMIN_TOKEN=

# CoreX is mid-way through splitting `name` into first_name / last_name.
# While true, registrations send both shapes so either side can deploy first.
# Set to false once CoreX has switched over.
COREX_WEBINAR_SEND_LEGACY_NAME=true

# ── Mobile app ───────────────────────────────────────────────────────
# The store listings, and the shared sandbox login /mobile-app hands out after
# someone leaves their details. Not a secret — we give it away on purpose — but
# rotate it here (and in CoreX) rather than in the template.
COREX_APP_ANDROID_URL="https://play.google.com/store/apps/details?id=za.co.corex_mobile&hl=en_ZA"
COREX_APP_IOS_URL="https://apps.apple.com/za/app/corex-os/id6792303320"
COREX_APP_DEMO_EMAIL=Demo@corexweb.co.za
COREX_APP_DEMO_PASSWORD=Corex@mobiledemo
